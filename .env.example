# ===============================
# AZIB — Environment Variables
# ===============================
# ضع القيم الحقيقية في .env.local (غير مرفوع للمستودع).
# لا تضع أي أسرار إنتاج في هذا الملف.

# الوضع التجريبي (true افتراضياً)
EXPO_PUBLIC_DEMO_MODE=true

# --- اختياري: Supabase (لاحقاً، ليس مطلوباً في Demo) ---
# مسموح فقط بمفتاح anon المحمي بـ RLS.
# ❌ ممنوع تماماً: service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- اختياري: خادم مستقل لاحقاً ---
EXPO_PUBLIC_API_BASE_URL=
